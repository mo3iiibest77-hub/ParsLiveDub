{
  "manifest_version": 3,
  "name": "ParsLiveDub",
  "version": "1.5.0",
  "description": "Live-dub any tab into 70+ languages with Gemini Live Translate. Bring your own API key.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ParsLiveDub"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
